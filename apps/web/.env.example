# Local dev matches docker-compose.yml at the repo root.
DATABASE_URL=postgres://botmarket:botmarket@localhost:5432/botmarket
REDIS_URL=redis://localhost:6379

# Auth.js (specs/06-auth.md). Generate: `pnpm exec auth secret`.
AUTH_SECRET=
# Google OAuth client — console.cloud.google.com credentials, authorized
# redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (specs/06-auth.md) — magic-link delivery. Unset in dev logs the
# link to the console instead of sending. Get a key at resend.com/api-keys;
# EMAIL_FROM must be on a domain verified in that Resend account.
RESEND_API_KEY=
EMAIL_FROM="BotMarket <noreply@botmarket.app>"

# Token sealing (specs/05-security.md). Generate a keypair with
# `uv run python keygen.py` in workers/runtime. PUBLIC key only here —
# the control plane can encrypt tokens but never decrypt them.
TOKEN_SEAL_PUBLIC_KEY=
# Pepper for trial-dedupe fingerprints; changing it invalidates stored fingerprints.
TOKEN_FINGERPRINT_PEPPER=

# Stripe (specs/03-billing.md). Test-mode secret key from the dashboard
# (prefer a restricted key — Checkout Sessions, Customers, Billing Portal
# Sessions, Webhook Endpoints: write; Products/Prices/Subscriptions: read).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (dashboard, or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Real test-mode price ids from the "Emcee (Emote Bot)" product in the
# BotMarket Stripe sandbox (acct_1TvEdqCGm1GlyQmy) — R$39/mo, R$390/yr.
# Same Stripe objects as before the 2026-07-20 catalog_bots slug rename
# (emote -> emcee) — only these env var names changed to match.
STRIPE_EMCEE_MONTHLY_PRICE_ID=price_1TvEjaCGm1GlyQmynwBLLv5P
STRIPE_EMCEE_ANNUAL_PRICE_ID=price_1TvEjdCGm1GlyQmybS1CMmtf
