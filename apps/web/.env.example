# Local dev matches docker-compose.yml at the repo root. Also carries config
# pub/sub via Postgres LISTEN/NOTIFY — no separate Redis URL needed since
# 2026-07-22 (docs/cost-plan.md, R6).
DATABASE_URL=postgres://botmarket:botmarket@localhost:5432/botmarket

# Auth.js (specs/06-auth.md). Generate: `pnpm exec auth secret`.
AUTH_SECRET=
# Google OAuth client — console.cloud.google.com credentials, authorized
# redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (specs/06-auth.md) — magic-link delivery. Unset in dev logs the
# link to the console instead of sending. Get a key at resend.com/api-keys;
# EMAIL_FROM must be on a domain verified in that Resend account.
RESEND_API_KEY=
EMAIL_FROM="BotMarket <noreply@botmarket.app>"

# Token sealing (specs/05-security.md). Generate a keypair with
# `uv run python keygen.py` in workers/runtime. PUBLIC key only here —
# the control plane can encrypt tokens but never decrypt them.
TOKEN_SEAL_PUBLIC_KEY=

# Stripe (specs/03-billing.md). Test-mode secret key from the dashboard
# (prefer a restricted key — Checkout Sessions, Customers, Billing Portal
# Sessions, Webhook Endpoints: write; Products/Prices/Subscriptions: read).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (dashboard, or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Real test-mode price ids from the "Emcee (Emote Bot)" product in the
# BotMarket Stripe sandbox (acct_1TvEdqCGm1GlyQmy) — R$39/mo, R$390/yr.
# Same Stripe objects as before the 2026-07-20 catalog_bots slug rename
# (emote -> emcee) — only these env var names changed to match.
STRIPE_EMCEE_MONTHLY_PRICE_ID=price_1TvEjaCGm1GlyQmynwBLLv5P
STRIPE_EMCEE_ANNUAL_PRICE_ID=price_1TvEjdCGm1GlyQmybS1CMmtf

# Crash-loop alert sweep (specs/04-bot-runtime.md). Checked against the
# Authorization: Bearer <CRON_SECRET> header Vercel Cron sends automatically
# on cron-triggered requests to /api/cron/*; a VPS crontab hitting the same
# URL with that header works identically.
CRON_SECRET=
# Supervisor dead-man's-switch (docs/decisions.md, 2026-07-23) — who
# /api/cron/supervisor-health emails when the runtime's heartbeat goes
# stale. Comma-separate for more than one address. This is us, not a
# customer; unset just means that alert logs to the console instead of
# sending (throws in production, same discipline as RESEND_API_KEY below).
OPS_ALERT_EMAIL=
# Base URL for links built in server-side contexts with no incoming request
# (e.g. the cron sweep) — checkout/actions.ts already falls back to this
# when there's no Origin header.
APP_ORIGIN=http://localhost:3000

# Sentry (specs/05-security.md: "Sentry both planes", before_send scrubber
# — see src/lib/sentry-scrub.ts). DSN isn't secret, it's write-only and fine
# client-visible; unset in dev just means errors aren't reported anywhere.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI for source-map upload at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog — product analytics. Project API key is write-only/public-safe.
# Unset in dev just means events aren't sent anywhere (PostHogProvider no-ops).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
