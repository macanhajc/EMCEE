# Data-plane hosts only. The PRIVATE half of the token-sealing keypair
# (generate: uv run python keygen.py) — never in control-plane config or CI.
TOKEN_SEAL_PRIVATE_KEY=

# Data-plane credentials are distinct from control-plane ones and get no
# access to billing tables (specs/05-security.md). Also carries config
# pub/sub via LISTEN/NOTIFY — no separate Redis URL needed since 2026-07-22
# (docs/cost-plan.md, R6).
DATABASE_URL=postgres://botmarket:botmarket@localhost:5432/botmarket
