# Single-box prod deploy (R1, docs/cost-plan.md). On the VPS:
#   cp .env.prod.example .env.prod   # then fill in real values
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Never commit the real .env.prod — see .gitignore (!.env.prod.example is
# the one deliberate carve-out, this template only).
#
# This is a separate file from apps/web/.env / workers/runtime/.env (dev,
# read directly by pnpm/uv) and from the root .env (docker-compose.yml,
# dev Postgres only) — don't mix them up. docker-compose.prod.yml derives
# both services' DATABASE_URL from the three POSTGRES_* values below, and
# APP_ORIGIN from DOMAIN, so those aren't repeated here.

# Public domain Caddy issues a Let's Encrypt cert for. "localhost" works
# for a local smoke test — Caddy falls back to its internal self-signed CA
# for that name, which no real browser trusts.
DOMAIN=

# Postgres — single shared instance for both planes (same as dev docker-
# compose.yml). Pick a real password; this is the one credential every
# other service in this file depends on.
POSTGRES_USER=botmarket
POSTGRES_PASSWORD=
POSTGRES_DB=botmarket

# --- apps/web — see apps/web/.env.example for what each of these does ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
EMAIL_FROM="BotMarket <noreply@botmarket.app>"
TOKEN_SEAL_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EMCEE_MONTHLY_PRICE_ID=
STRIPE_EMCEE_ANNUAL_PRICE_ID=
CRON_SECRET=
OPS_ALERT_EMAIL=
# Baked into the client bundle at image build time (docker-compose.prod.yml
# passes these as build args too, not just runtime env) — real values here
# if you want Sentry/PostHog wired into the shipped image.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional — enables Sentry source-map upload during the image build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- workers/runtime — see workers/runtime/.env.example ---
TOKEN_SEAL_PRIVATE_KEY=
